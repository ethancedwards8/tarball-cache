      "zmij" = rec {
        crateName = "zmij";
        version = "1.0.23";
        edition = "2021";
        sha256 = "06zwri21nnrl34rwinmvbciap8yk1mrl8qfg9pff7lgspc56sri9";
        authors = [
          "David Tolnay <dtolnay@gmail.com>"
        ];
